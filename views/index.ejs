<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">

    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Document</title>
</head>
<body>


<table class="table">
  <thead>
    <tr>
      <th scope="col">First</th>
      <th scope="col">Last</th>
      <th scope="col">Tytul</th>
      <th scope="col">USUN/MODYFIKUJ</th>
    </tr>
  </thead>
  <tbody class="table-group-divider">
     <% users.forEach(u => { %>
        <tr>
            <td><%= u.name %></td>
            <td><%= u.lastname %></td>
            <td>
                <% u.title.forEach(t => { %>
                    <li><%= t.title %></li>
                <% }) %>
                </td>
            <td><button name = "przycisk1" type="submit" action = "/usun" method = "POST" data-id="<%= u.id %>" class="btn btn-danger usun-btn">USUN</button>
            <button type="button"
        class="btn btn-warning modyfikuj-btn"
        data-id="<%= u.id %>"
        data-bs-toggle="modal"
        data-bs-target="#modyfikujModal">
    MODYFIKUJ
</button>
          </td>
        </tr>
    <% })%>


  </tbody>
</table>
<form id="addAuthorForm" class="row g-3">
  <div class="col-md-2">
    <input name="name" id="addname" class="form-control" type="text" placeholder="Imię" required>
  </div>
  <div class="col-md-2">
    <input name="lastname" id="addlastname" class="form-control" type="text" placeholder="Nazwisko" required>
  </div>
  <div class="col-md-2">
    <input name="titleName" id="addtitle" class="form-control" type="text" placeholder="Tytuł" required>
  </div>
  <div class="col-md-2">
    <button type="submit" class="btn btn-success">Dodaj</button>
  </div>
</form>
<div class="modal fade" id="modyfikujModal" tabindex="-1" aria-hidden="true">
  <div class="modal-dialog">
    <div class="modal-content">
      <div class="modal-header">
        <h5 class="modal-title">Modyfikuj rekord</h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
      </div>
      <form id="modyfikujForm" action="/modyfikuj" method="POST">
        <div class="modal-body">
          <input type="hidden" name="id" id="modal-user-id">
         
          <div class="mb-3">
            <label for="wybor-opcji" class="form-label">Wybierz opcję:</label>
            <div class="col-md-2">
            <input name="trzeciePole" class ="form-control" type="text" placeholder="Default input" aria-label="tytul">
             </div>
            <select class="form-select" name="opcja" id="wybor-opcji" required>
              <option value="" selected disabled>Wybierz z listy...</option>
              <option value="1">Imie</option>
              <option value="2">Nazwisko</option>
              <option value="3">Tytul</option>
            </select>
           
          </div>
         
        </div>
       
        <div class="modal-footer">
          <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Anuluj</button>
          <button type="submit" class="btn btn-primary">Zapisz zmiany</button>
        </div>
      </form>
    </div>
  </div>
</div>
</body>
</html>
<script>
  const addForm = document.getElementById('addAuthorForm');
  addForm.onsubmit = async (e) => {
  e.preventDefault(); 

  const data = {
    name: document.getElementById('addname').value,
    lastname: document.getElementById('addlastname').value,
    titleName: document.getElementById('addtitle').value
  };

  try {
    const response = await fetch('/api/authors', { 
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify(data)
    });

    if (response.ok) {
      location.reload(); 
    } else {
      alert('Błąd podczas dodawania');
    }
  } catch (err) {
    console.error('Błąd:', err);
  }
};
  const modalEl = document.getElementById('modyfikujModal');
  if (modalEl) {
      modalEl.addEventListener('show.bs.modal', function (event) {
        const button = event.relatedTarget;
        const id = button.getAttribute('data-id');
        document.getElementById('modal-user-id').value = id;
      });
  }

  document.querySelectorAll('.usun-btn').forEach(btn => {
    btn.onclick = async (e) => {
      const id = e.currentTarget.dataset.id;
      if (!id || id === "undefined") {
          console.error("Blad brak id");
          return;
      }
      if (!confirm('Czy na pewno usunac')) return;
      try {
        const response = await fetch(`/api/authors/${id}`, { method: 'DELETE' });
        if (response.ok) location.reload();
      } catch (err) {
        console.error('Błąd sieci:', err);
      }
    }
  });
</script>




<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>